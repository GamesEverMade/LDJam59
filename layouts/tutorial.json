      "behaviors": [],
      "content": {
        "text": "[b]The city is under attack by gnolls and you must signal the defences where to strike![/b]\n\n[b]Drag a flag[/b] and an [b]item[/b] to the center of the screen and [b]press OK/Space bar/Return[/b] to send the signal\nEach [b]flag stands for a region[/b] and each [b]item for a type of gnoll[/b]\nFlags and items [b]drop back straight from where they were used[/b], careful not to make a mess\n\nUse the [b]arrows on screen[/b] to look around between regions\n\nWatch for the [b]action cooldown timer[/b]\nReach the end of [b]three days straight[/b] to win",
        "opacity": 255,
        "fontSize": 41,
        "visible": true,
        "color": "0;0;0",
        "fontFamily": "assets/JO______.TTF",
        "align": "left",
        "verticalTextAlignment": "top"
      }
